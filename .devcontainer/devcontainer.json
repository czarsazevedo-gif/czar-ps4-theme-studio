{
  "name": "Czar PS4 Theme Studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Czar PS4 Theme Studio",
      "protocol": "http",
      "onAutoForward": "notify",
      "requireLocalPort": true
    }
  },
  "postCreateCommand": "bash ./scripts/bootstrap_czar_full.sh --install",
  "postStartCommand": "bash ./scripts/setup_codespace.sh --quick",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1"
  }
}
