{
  "name": "Czar PS4 Theme Studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Czar PS4 Theme Studio",
      "protocol": "http",
      "onAutoForward": "notify",
      "requireLocalPort": true
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends ffmpeg && python -m pip install -r requirements.txt",
  "postStartCommand": "test -x ./start.sh && command -v ffprobe",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1"
  }
}
